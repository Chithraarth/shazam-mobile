{
  "expo": {
    "name": "Videofy",
    "slug": "shazam-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shazam-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6A2BFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.videofy.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "Videofy uses your camera to scan screens and identify movies and TV shows.",
        "NSPhotoLibraryUsageDescription": "Videofy accesses your photos so you can upload frames for identification.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "production"
      },
      "appleTeamId": "UZKCN9NQ7G",
      "buildNumber": "2"
    },
    "android": {
      "package": "com.videofy.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Videofy uses your camera to scan screens and identify movies and TV shows."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Videofy accesses your photos so you can upload frames for identification."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.816984918533-vbt1bm34gtki8em3e3hdm69dle406mjd"
        }
      ],
      "./plugins/with-ios-27.js",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-localization",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsImageWithMaxCount": 1
          },
          "androidIntentFilters": [
            "image/*"
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/unbounded/700Bold/Unbounded_700Bold.ttf",
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/800ExtraBold/PlusJakartaSans_800ExtraBold.ttf"
          ],
          "widgets": [
            {
              "name": "Scan",
              "label": "Videofy",
              "description": "Scan what’s on screen in one tap",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-quick-actions",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAuth",
              "RNFBMessaging"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
