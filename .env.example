# Firebase config lives in lib/firebase.ts (not secret) and the
# google-services.json / GoogleService-Info.plist files (also not secret —
# safe to commit, same as any Firebase client config). No env vars needed
# for auth.

# Hostname (no protocol) where the backend API is reachable, e.g. api.example.com
# The app calls https://<EXPO_PUBLIC_DOMAIN>/api/...
EXPO_PUBLIC_DOMAIN=localhost:8080

# Product ID of the one-time consumable product created in Play Console →
# Monetize → Products → In-app products (must match the SCAN_PACKS key in
# the backend's src/routes/billing.ts)
EXPO_PUBLIC_SCAN_PACK_PRODUCT_ID=scan_pack_50
